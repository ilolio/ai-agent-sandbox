# プロジェクトごとにこのファイルをコピーして使う。
# 例:  cp env.example project-configs/myapp.env  → 編集 → ./agent.sh myapp up

# プロジェクト名（コンテナ名・compose project 名になる）
PROJECT=myapp

# ★このプロジェクトの言語(flavor)。Dockerfile の build target が切り替わる。
#   node   … Node.js（既定）
#   python … Python + uv
#   go     … Go
# 言語を増やしたいときは Dockerfile に「FROM base AS <name>」ステージを足す。
FLAVOR=python

# ★このフォルダだけがコンテナから見える。絶対パス推奨。
WORKSPACE=/home/youruser/code/myapp

# ============================================================
# llama-server の設定（2 モードから選ぶ）
# ============================================================
#
# ■ モードA: ホスト版（既定）
#   host 側で自分で起動した llama-server に繋ぐ。BUNDLED は書かない（or 0）。
LLAMA_HOST=host.docker.internal
LLAMA_PORT=8080
CLAUDE_MODEL=local-model

# ■ モードB: 同梱（バンドル）版
#   llama-server を agent と一緒に compose で起動する。host 側の起動は不要。
#   BUNDLED=1 にすると agent.sh が docker-compose.llama.yml を重ねる。
#   このとき LLAMA_HOST/LLAMA_PORT は overlay 側で llama サービスに自動で向くので
#   上の 2 行は無視される。
# BUNDLED=1
#
#   同梱時に使うイメージ・モデル・context。未指定なら下のコメントが既定値。
# LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server          # 既定(CPU)
# LLAMA_MODEL=unsloth/Qwen3-Coder-30B-GGUF:Q4_K_M        # -hf で取得するモデル
# LLAMA_CTX=32768                                         # context size
#
#   GPU(NVIDIA) を使う場合（NVIDIA Container Toolkit が必要）:
# LLAMA_GPU=1                                             # GPU overlay を重ねる
# LLAMA_NGL=99                                            # GPU offload 層数
# LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda     # cuda イメージ(未指定でも GPU 時はこれが既定)
# LLAMA_GPU_COUNT=all                                     # 使う GPU 数（既定 all）

# ★このプロジェクトで許可する egress 先（カンマ区切り）。
#   llama-server への接続は自動で許可されるのでここには書かなくてよい。
#   下は各言語のパッケージ取得に必要な汎用ドメインをひと通り許可する例。
#   (compose の .env は行継続できないので 1 行で書く。不要な分は削ってよい)
#     npm    : registry.npmjs.org
#     pip/uv : pypi.org,files.pythonhosted.org,astral.sh
#     go mod : proxy.golang.org,sum.golang.org
#     github : github.com,codeload.github.com,raw.githubusercontent.com,objects.githubusercontent.com
ALLOWED_DOMAINS=registry.npmjs.org,pypi.org,files.pythonhosted.org,astral.sh,proxy.golang.org,sum.golang.org,github.com,codeload.github.com,raw.githubusercontent.com,objects.githubusercontent.com

# 完全遮断（ローカルLLMのみ・パッケージ取得もさせない）なら空にする:
# ALLOWED_DOMAINS=

# ファイアウォール自体を切る場合（非推奨）: ENABLE_FIREWALL=0

# host の uid/gid に合わせるとマウント先の権限がズレない
HOST_UID=1000
HOST_GID=1000
