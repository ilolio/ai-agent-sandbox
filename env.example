# プロジェクトごとにこのファイルをコピーして使う。
# 例:  cp env.example project-configs/myapp.env  → 編集 → ./agent.sh myapp up

# プロジェクト名（コンテナ名・compose project 名になる）
PROJECT=myapp

# ★このプロジェクトの言語(flavor)。Dockerfile の build target が切り替わる。
#   node   … Node.js（既定）
#   python … Python + uv
#   go     … Go
# 言語を増やしたいときは Dockerfile に「FROM base AS <name>」ステージを足す。
FLAVOR=python

# ★このフォルダだけがコンテナから見える。絶対パス推奨。
WORKSPACE=/home/youruser/code/myapp

# llama-serverの設定
# host 側で動いている llama-server への接続例
LLAMA_HOST=host.docker.internal
LLAMA_PORT=8080
CLAUDE_MODEL=local-model

# Claude Code に伝えるモデルの context/output 上限（OPENCODE_CTX/OUT の Claude Code 版）。
# CTX は llama-server の --ctx-size に合わせる。教えないと Claude Code は未知のモデル ID
# として独自に仮定した context 幅で compact してしまい、実サイズと閾値がズレる。
# OUT は毎リクエストの max_tokens 上限。CTX - OUT が残りプロンプト予算（自動 compact の
# 閾値）になるので、CTX が小さいサーバでは OUT も下げること。
CLAUDE_CTX=131072
CLAUDE_OUT=32000

# ※ 上記以外の Claude Code 側設定（haiku などエイリアスの解決先、thinking / prompt caching の
#   無効化、タイムアウト、telemetry 停止）は entrypoint.sh が settings.json に書き込む。
#   プロジェクトごとに変える必要が無いので env には出していない。

# ★既定のエージェント（claude | opencode）。
#   CLI は両方イメージに入っているので、./agent.sh <p> claude / opencode で
#   都度切り替えられる。これは ./agent.sh <p> run / yolo が使う既定値。
AGENT=claude

# OpenCode 用のモデル名。llama-server が同じモデルを出しているなら書かなくてよい
# （空なら CLAUDE_MODEL を使う）。
# OPENCODE_MODEL=

# OpenCode に伝えるモデルの context/output 上限。
# CTX は llama-server の --ctx-size に合わせる（大きすぎるとサーバ側でエラーになる）。
# OUT は OpenCode が毎リクエストの max_tokens に使う値。小さいと出力が途中で切れる。
# OpenCode は内部的に 32k 程度で頭打ちにするので 32000 が実質上限。
# ただし CTX - OUT が残りプロンプト予算（自動 compact の閾値）になるので、
# CTX が小さいサーバでは OUT も下げること。
OPENCODE_CTX=131072
OPENCODE_OUT=32000

# ★このプロジェクトで許可する egress 先（カンマ区切り）。
#   llama-server への接続は自動で許可されるのでここには書かなくてよい。
#   下は各言語のパッケージ取得に必要な汎用ドメインをひと通り許可する例。
#   (compose の .env は行継続できないので 1 行で書く。不要な分は削ってよい)
#     npm      : registry.npmjs.org
#     pip/uv   : pypi.org,files.pythonhosted.org,astral.sh
#     go mod   : proxy.golang.org,sum.golang.org
#     github   : github.com,codeload.github.com,raw.githubusercontent.com,objects.githubusercontent.com
#     opencode : models.dev（モデルカタログ）。プロバイダ SDK の取得に registry.npmjs.org も要る
ALLOWED_DOMAINS=registry.npmjs.org,models.dev,pypi.org,files.pythonhosted.org,astral.sh,proxy.golang.org,sum.golang.org,github.com,codeload.github.com,raw.githubusercontent.com,objects.githubusercontent.com

# 完全遮断（ローカルLLMのみ・パッケージ取得もさせない）なら空にする:
# ALLOWED_DOMAINS=
# ※ OpenCode は初回起動時に registry.npmjs.org からプロバイダ SDK を取るので、
#   完全遮断で使いたい場合は一度ネット許可で起動して取得を済ませてから空にする
#   （取得物は opencode-config ボリュームに残る）。

# ファイアウォール自体を切る場合（非推奨）: ENABLE_FIREWALL=0

# host の uid/gid に合わせるとマウント先の権限がズレない
HOST_UID=1000
HOST_GID=1000
